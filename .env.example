# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit secrets.

# Notion integration token from notion.so/my-integrations
# (starts with "secret_" or "ntn_")
NOTION_TOKEN=

# Notion database ID — the 32-char string in the database URL
# between the last "/" and the "?"
NOTION_DATABASE_ID=

# Your Gmail address — must match the account you OAuth as
GMAIL_USER=youremail@gmail.com

# Your Kindle email — found at amazon.com → Manage Your Content
# and Devices → Personal Document Settings
KINDLE_EMAIL=yourname_xxxxx@kindle.com

# The address you added to Amazon's Approved Personal Document
# Email List. Usually identical to GMAIL_USER.
APPROVED_SENDER=youremail@gmail.com
